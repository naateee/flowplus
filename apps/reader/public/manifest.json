{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "FlowPlus",
  "short_name": "FlowPlus",
  "description": "本地优先的 EPUB 阅读器（基于 Flow 修改）",
  "icons": [
    {
      "src": "/icons/192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "/icons/512.png",
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": "/icons/maskable-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "maskable"
    },
    {
      "src": "/icons/maskable-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    }
  ],
  "theme_color": "#006591",
  "background_color": "#ffffff",
  "start_url": "/",
  "display": "standalone",
  "orientation": "any",
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/epub+zip": ".epub",
        "application/epub": ".epub"
      },
      "launch_type": "single-client"
    }
  ]
}
